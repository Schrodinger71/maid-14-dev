<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maths="clr-namespace:Robust.Shared.Maths;assembly=Robust.Shared.Maths"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:animated="clr-namespace:Content.Client._Maid.UserInterface.AnimatedBackground"
    xmlns:maidControls="clr-namespace:Content.Client._Maid.Lobby.UI"
    xmlns:whiteButtons="clr-namespace:Content.Client._White.UserInterface.Buttons">
    <!-- Background -->
    <animated:AnimatedBackgroundControl Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background" /> <!-- Tweak-Maid: Animated Lobby -->
    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Vertical"
                  Margin="10 10 10 10" SeparationOverride="2">
        <LayoutContainer Name="DefaultState" VerticalExpand="True" HorizontalExpand="True">
            <!-- Voting popups: overlaid on top-left, must NOT push BottomSide down -->
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                          Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <!-- Main 3-column "White Dream" layout -->
            <BoxContainer Name="BottomSide" Orientation="Horizontal" VerticalAlignment="Stretch"
                          HorizontalExpand="True" VerticalExpand="True"
                          SeparationOverride="8" Margin="0 10 0 10">

                    <!-- COLUMN 1: left menu (plain text items, no boxes) -->
                    <BoxContainer Orientation="Vertical" MinSize="200 0" MaxSize="280 Infinity"
                                  Margin="16 24 0 0" SeparationOverride="14">
                        <!-- Push the menu block to the vertical center of the column -->
                        <Control VerticalExpand="True" />
                        <Label Text="Maid Cafe" StyleClasses="LobbyTitle" Margin="0 0 0 0" />

                        <!-- Ready state toggle: shows "Not Ready"/"Ready" -->
                        <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                HorizontalAlignment="Left"
                                Text="{Loc 'lobby-state-player-status-not-ready'}"
                                StyleClasses="MenuTextButton" Margin="12 0 0 0" />

                        <Button Name="MenuCharacterSetupButton" Text="{Loc 'ui-lobby-character-setup-button'}" StyleClasses="MenuTextButton"
                                HorizontalAlignment="Left" Margin="12 0 0 0" />
                        <Button Name="MenuRulesButton" Text="{Loc 'server-info-rules-button'}" StyleClasses="MenuTextButton"
                                HorizontalAlignment="Left" Margin="12 0 0 0" />
                        <Button Name="MenuGuidebookButton" Text="{Loc 'server-info-guidebook-button'}" StyleClasses="MenuTextButton"
                                HorizontalAlignment="Left" Margin="12 0 0 0" />
                        <Button Name="MenuChangelogButton" Text="{Loc 'changelog-button'}" StyleClasses="MenuTextButton"
                                HorizontalAlignment="Left" Margin="12 0 0 0" />
                        <Button Name="OptionsButton" Access="Public" Text="{Loc 'ui-lobby-options-button'}" StyleClasses="MenuTextButton"
                                HorizontalAlignment="Left" Margin="12 0 0 0" />
                        <Button Name="MenuDiscordButton" Access="Public" Text="{Loc 'rmc-ui-link-discord-account'}" StyleClasses="MenuTextButton"
                                HorizontalAlignment="Left" Margin="12 0 0 0" />

                        <!-- Observe (with warning window) -->
                        <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                            HorizontalAlignment="Left"
                                            Text="{Loc 'ui-lobby-observe-button'}"
                                            StyleClasses="MenuTextButton"
                                            Margin="12 0 0 0"
                                            WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />

                        <!-- Extra lobby tools moved from the top bar -->
                        <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                                HorizontalAlignment="Left" StyleClasses="MenuTextButton" Margin="12 0 0 0" />
                        <vote:VoteCallMenuButton Name="CallVoteButton" HorizontalAlignment="Left" StyleClasses="MenuTextButton" Margin="12 0 0 0" />
                        <whiteButtons:CustomGhostsMenuOpenButton Name="CustomGhostsButton" Text="{Loc 'ui-lobby-custom-ghosts-button'}"
                                                                 HorizontalAlignment="Left" StyleClasses="MenuTextButton" Margin="12 0 0 0" />

                        <Button Name="LeaveButton" Access="Public" Text="{Loc 'ui-lobby-leave-button'}" StyleClasses="MenuTextButton"
                                HorizontalAlignment="Left" Margin="12 0 0 0" />

                        <Control VerticalExpand="True" />
                        <Label Text="Version: 1.0" StyleClasses="LobbyVersion" HorizontalAlignment="Left" />
                        <!-- Character preview & preferences: kept hidden for code wiring (not shown on this screen) -->
                        <BoxContainer Name="HiddenCharacterArea" Visible="False" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                            <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" HorizontalExpand="True" VerticalExpand="True" />
                            <maidControls:CharacterPreferencesWidget Name="PreferencesWidget" Access="Public" HorizontalExpand="True" Margin="0 0 0 0"/>
                        </BoxContainer>
                    </BoxContainer>

                    <!-- Spacer pushing the changelog panel toward the right -->
                    <Control HorizontalExpand="True" />

                    <!-- COLUMN 2: changelog (always expanded, boxed, narrow, right-aligned) -->
                    <PanelContainer Name="ChangelogPanel" Access="Public"
                                    StyleClasses="TransparentBorderedWindowPanel"
                                    SetWidth="380" Margin="0 0 0 0" VerticalExpand="True">
                        <!-- Shared semi-transparent frame: header + body inside it -->
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                                      Margin="6 4 6 6" SeparationOverride="0">
                            <!-- Header: centered in its own column -->
                            <Label Text="Список изменений" StyleClasses="LobbyHeading"
                                   HorizontalAlignment="Center" Margin="0 0 0 4" />
                            <!-- Body: always visible, shares the panel frame -->
                            <PanelContainer Name="ChangelogBodyPanel" Access="Public"
                                            VerticalExpand="True" HorizontalExpand="True">
                                <ScrollContainer Name="ChangelogScrollContainer" Access="Public"
                                                 VerticalExpand="True" HorizontalExpand="True"
                                                 HScrollEnabled="False" ReserveScrollbarSpace="False">
                                    <BoxContainer Orientation="Vertical" Name="ChangelogBodyContainer" Access="Public"
                                                  HorizontalExpand="True" Margin="0 0 8 0" />
                                </ScrollContainer>
                            </PanelContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- COLUMN 3: server info + chat (single panel, announcement is part of chat) -->
                    <PanelContainer StyleClasses="TransparentBorderedWindowPanel"
                                    MinSize="360 0" MaxSize="470 Infinity" Margin="0 0 0 0"
                                    VerticalExpand="True">
                        <!-- Outer box has no insets so the chat can reach the panel edges -->
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                                      SeparationOverride="6">
                            <!-- Top part: title + server info, with its own insets -->
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True"
                                          Margin="8 8 8 0" SeparationOverride="8">
                                <Label Name="ServerName" Access="Public" StyleClasses="LobbyTitle"
                                       VAlign="Center" HorizontalExpand="True" HorizontalAlignment="Center"
                                       Margin="0 0 0 10" />
                                <Label Text="Серверная информация:" StyleClasses="LobbyHeading" Margin="0 0 0 4" />
                                <info:ServerInfo Name="ServerInfo" Access="Public" StyleClasses="LobbyText"
                                                 MinSize="0 30" VerticalExpand="false" Margin="3 3 3 3"
                                                 HorizontalAlignment="Left" />
                                <Label Name="StationTime" Access="Public" StyleClasses="LobbyText"
                                       FontColorOverride="{x:Static maths:Color.LightGray}"
                                       Margin="3 3 3 10" HorizontalAlignment="Left" />
                                <!-- Round start countdown (inside server info panel) -->
                                <Label Name="StartTime" Access="Public" Align="Center"
                                       FontColorOverride="{x:Static maths:Color.DarkGray}"
                                       StyleClasses="LobbyText" HorizontalExpand="True"
                                       Margin="3 3 3 8" />
                            </BoxContainer>
                            <!-- Chat: stretches to the full width of the panel and down to its bottom edge -->
                            <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True"
                                             HorizontalExpand="True"
                                             MinSize="0 225" Margin="0 0 0 0" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
        </LayoutContainer>
        <!-- Character setup state -->
        <!-- This is injected on startup. Funky! -->
        <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
    </BoxContainer>
</lobbyUi:LobbyGui>
